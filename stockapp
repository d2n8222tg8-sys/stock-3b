  sel.value = catId;
  applyRoleVisibility();
  showScreen('add');
}
function cancelAdd(){
  if(state.currentCat) showScreen('cat');
  else goTab('home');
}
function saveProduct(ev){
  ev.preventDefault();
  const f = ev.target;
  const data = Object.fromEntries(new FormData(f));
  const p = {
    id:uid(),
    name:data.name.trim(),
    ref:data.ref.trim(),
    cat:data.cat,
    qty:parseInt(data.qty)||0,
    threshold:parseInt(data.threshold)||5,
    location:data.location.trim(),
    supplier:data.supplier.trim(),
    price:parseFloat(data.price)||0,
  };
  state.products.push(p);
  save();
  toast('Référence ajoutée');
  state.currentCat = p.cat;
  openCategory(p.cat);
}

/* ============================================================
   REORDER + PDF
   ============================================================ */
function renderReorder(){
  const list = document.getElementById('reorderList');
  const items = state.products.filter(p=>p.qty < p.threshold);
  if(items.length===0){
    list.innerHTML = `<div class="empty">
      <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
      <p>Tout est en stock 👍<br>Aucun produit n'a besoin d'être recommandé.</p></div>`;
    return;
  }
  list.innerHTML='';
  items.forEach(p=>{
    const c = CATS.find(c=>c.id===p.cat);
    const need = p.threshold * 2 - p.qty;
    const el = document.createElement('div');
    el.className='product low';
    el.innerHTML = `
      <div class="product-head">
        <div style="flex:1">
          <div class="name">${escapeHtml(p.name)}</div>
          <div class="ref">${escapeHtml(p.ref)} · ${c.name}</div>
        </div>
        <div style="text-align:right">
          <div class="qty">${p.qty}</div>
          <div class="qty-unit">restant</div>
        </div>
      </div>
      <div class="product-meta">
        <span>Fournisseur : <b>${escapeHtml(p.supplier||'—')}</b></span>
        <span>À commander : <b style="color:var(--yellow)">${need}</b></span>
      </div>`;
    list.appendChild(el);
  });
}

function generatePDF(){
  const items = state.products.filter(p=>p.qty < p.threshold);
  if(items.length===0){toast('Rien à commander','error');return}
  const {jsPDF} = window.jspdf;
  const doc = new jsPDF();
  // En-tête
  doc.setFillColor(63,165,53);
  doc.rect(0,0,210,30,'F');
  doc.setTextColor(255,255,255);
  doc.setFont('helvetica','bold').setFontSize(24);
  doc.text('3B INTER',15,18);
  doc.setFontSize(10).setFont('helvetica','normal');
  doc.text('Atelier — Bon de commande',15,25);
  doc.setTextColor(0,0,0);

  doc.setFontSize(14).setFont('helvetica','bold');
  doc.text('Bon de commande N° '+Date.now().toString().slice(-6), 15, 45);
  doc.setFontSize(10).setFont('helvetica','normal');
  doc.text('Date : '+new Date().toLocaleDateString('fr-FR'), 15, 52);
  doc.text('Émis par : '+state.user.name, 15, 57);

  // Tableau
  let y = 70;
  doc.setFillColor(13,17,23);
  doc.setTextColor(255,255,255);
  doc.rect(15,y-5,180,8,'F');
  doc.setFontSize(9).setFont('helvetica','bold');
  doc.text('Référence',17,y);
  doc.text('Désignation',55,y);
  doc.text('Stock',125,y);
  doc.text('À cmd.',145,y);
  doc.text('Fournisseur',165,y);

  doc.setTextColor(0,0,0);
  doc.setFont('helvetica','normal');
  y+=10;
  items.forEach((p,i)=>{
    if(y>270){doc.addPage(); y=20}
    if(i%2===0){doc.setFillColor(245,245,245);doc.rect(15,y-5,180,7,'F')}
    const need = Math.max(1, p.threshold*2 - p.qty);
    doc.setFontSize(8);
    doc.text(p.ref.substring(0,18), 17, y);
    doc.text(p.name.substring(0,30), 55, y);
    doc.text(String(p.qty), 128, y);
    doc.setFont('helvetica','bold');
    doc.text(String(need), 148, y);
    doc.setFont('helvetica','normal');
    doc.text((p.supplier||'—').substring(0,15), 165, y);
    y+=7;
  });

  // Pied de page
  y = Math.max(y+10, 240);
  doc.setFontSize(9);
  doc.text('Total références à commander : '+items.length, 15, y);
  y+=20;
  doc.line(15,y,90,y);
  doc.line(120,y,195,y);
  doc.setFontSize(8);
  doc.text('Signature demandeur',15,y+5);
  doc.text('Signature responsable',120,y+5);

  doc.save('bon_commande_3b_'+new Date().toISOString().slice(0,10)+'.pdf');
  toast('PDF généré');
}

/* ============================================================
   DASHBOARD
   ============================================================ */
let chartC=null, chartT=null;
function renderDash(){
  if(state.user?.role!=='patron'){toast('Accès patron uniquement','error');goTab('home');return}
  document.getElementById('kpiTotal').textContent = state.products.length;
  document.getElementById('kpiLow').textContent = state.products.filter(p=>p.qty<p.threshold).length;
  const total = state.products.reduce((s,p)=>s+p.qty*(p.price||0),0);
  document.getElementById('kpiValue').innerHTML = total.toFixed(0)+'<span class="unit"> €</span>';
  const today = new Date(); today.setHours(0,0,0,0);
  document.getElementById('kpiMoves').textContent = state.history.filter(h=>h.date >= today.getTime()).length;

  // Chart consommation 7j
  const days = [];
  for(let i=6;i>=0;i--){
    const d = new Date(); d.setHours(0,0,0,0); d.setDate(d.getDate()-i);
    days.push({d, label:d.toLocaleDateString('fr-FR',{weekday:'short'})});
  }
  const data = days.map(({d})=>{
    const next = d.getTime()+86400000;
    return state.history.filter(h=>h.type==='out' && h.date>=d.getTime() && h.date<next)
                         .reduce((s,h)=>s+h.qty,0);
  });
  if(chartC) chartC.destroy();
  chartC = new Chart(document.getElementById('chartConsum'),{
    type:'line',
    data:{labels:days.map(d=>d.label),datasets:[{
      data,borderColor:'#3FA535',backgroundColor:'rgba(63,165,53,0.15)',
      tension:.35,fill:true,pointBackgroundColor:'#3FA535',pointRadius:4
    }]},
    options:{plugins:{legend:{display:false}},scales:{
      x:{ticks:{color:'#8b949e'},grid:{display:false}},
      y:{ticks:{color:'#8b949e'},grid:{color:'rgba(255,255,255,.05)'}}}
    }
  });

  // Top 5
  const usage = {};
  state.history.filter(h=>h.type==='out').forEach(h=>{
    usage[h.productName] = (usage[h.productName]||0)+h.qty;
  });
  const top = Object.entries(usage).sort((a,b)=>b[1]-a[1]).slice(0,5);
  if(chartT) chartT.destroy();
  chartT = new Chart(document.getElementById('chartTop'),{
    type:'bar',
    data:{labels:top.map(t=>t[0].substring(0,15)),datasets:[{
      data:top.map(t=>t[1]),
      backgroundColor:['#3FA535','#F5C518','#ff8800','#42a5f5','#9c9c9c'],
      borderRadius:6
    }]},
    options:{indexAxis:'y',plugins:{legend:{display:false}},scales:{
      x:{ticks:{color:'#8b949e'},grid:{color:'rgba(255,255,255,.05)'}},
      y:{ticks:{color:'#8b949e'},grid:{display:false}}}
    }
  });

  // Mouvements récents
  const rm = document.getElementById('recentMoves');
  rm.innerHTML='';
  state.history.slice(0,6).forEach(h=>rm.appendChild(historyEl(h)));
}

/* ============================================================
   HISTORY
   ============================================================ */
function renderHistory(){
  const list = document.getElementById('historyList');
  list.innerHTML='';
  let h = state.history.slice();
  if(state.historyFilter!=='all') h = h.filter(x=>x.type===state.historyFilter);
  if(h.length===0){list.innerHTML='<div class="empty"><p>Aucun mouvement.</p></div>';return}
  h.forEach(x=>list.appendChild(historyEl(x)));
}
function filterHistory(f){
  state.historyFilter=f;
  document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('active', c.dataset.hf===f));
  renderHistory();
}
function historyEl(h){
  const el = document.createElement('div');
  el.className = 'history-item '+h.type;
  const ico = h.type==='out'
    ? '<svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7 7 7-7"/></svg>'
    : '<svg viewBox="0 0 24 24"><path d="M12 5v14M19 12l-7-7-7 7"/></svg>';
  const d = new Date(h.date);
  const dStr = d.toLocaleDateString('fr-FR',{day:'2-digit',month:'short'})+' · '+d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  el.innerHTML = `
    <div class="ico">${ico}</div>
    <div class="info">
      <div class="n">${escapeHtml(h.productName)}</div>
      <div class="d">${dStr} · ${escapeHtml(h.user)}</div>
    </div>
    <div class="q">${h.type==='out'?'-':'+'}${h.qty}</div>`;
  return el;
}

/* ============================================================
   EXPORT CSV
   ============================================================ */
function exportExcel(){
  let csv = 'Référence;Nom;Catégorie;Quantité;Seuil;Emplacement;Fournisseur;Prix unitaire;Valeur\n';
  state.products.forEach(p=>{
    const c = CATS.find(c=>c.id===p.cat);
    csv += [p.ref, p.name, c?.name||p.cat, p.qty, p.threshold, p.location||'', p.supplier||'',
            (p.price||0).toFixed(2), (p.qty*(p.price||0)).toFixed(2)].join(';')+'\n';
  });
  const blob = new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download='inventaire_3b_'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
  URL.revokeObjectURL(url);
  toast('Export CSV téléchargé');
}

/* ============================================================
   THEME
   ============================================================ */
function toggleTheme(){
  document.body.classList.toggle('light');
  state.theme = document.body.classList.contains('light')?'light':'dark';
  save();
}

/* ============================================================
   UTILS
   ============================================================ */
function toast(msg, type){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast '+(type==='error'?'error':'')+' show';
  setTimeout(()=>t.classList.remove('show'), 2200);
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}

document.getElementById('modal').addEventListener('click',e=>{
  if(e.target.id==='modal') closeModal();
});

/* ============================================================
   INIT
   ============================================================ */
load();
</script>

