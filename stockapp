  showScreen('cat');
}
function renderCategory(catId){
  const list = document.getElementById('productList');
  const q = document.getElementById('catSearch').value.trim().toLowerCase();
  let prods = state.products.filter(p=>p.cat===catId);
  if(q) prods = prods.filter(p=>p.name.toLowerCase().includes(q) || p.ref.toLowerCase().includes(q));
  list.innerHTML='';
  if(prods.length===0){
    list.innerHTML = `<div class="empty">
      <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
      <p>Aucune référence dans cette catégorie.<br>Ajoutez la première avec le bouton ci-dessous.</p></div>`;
    return;
  }
  const c = CATS.find(c=>c.id===catId);
  prods.forEach(p=>{
    const low = p.qty < p.threshold;
    const el = document.createElement('div');
    el.className='product'+(low?' low':'');
    el.innerHTML = renderProductHTML(p, c);
    list.appendChild(el);
  });
}
function renderProductHTML(p, c){
  const low = p.qty < p.threshold;
  const isBoss = state.user?.role==='patron';
  return `
    <div class="product-head">
      <div style="flex:1;min-width:0">
        <div class="name">${escapeHtml(p.name)}</div>
        <div class="ref">${escapeHtml(p.ref)}</div>
        ${low?'<span class="low-tag">Stock faible</span>':''}
      </div>
      <div style="text-align:right">
        <div class="qty">${p.qty}</div>
        <div class="qty-unit">en stock</div>
      </div>
    </div>
    <div class="product-meta">
      ${p.location?`<span><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${escapeHtml(p.location)}</span>`:''}
      ${p.supplier?`<span><svg viewBox="0 0 24 24"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7M5.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM18.5 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>${escapeHtml(p.supplier)}</span>`:''}
      ${isBoss && p.price?`<span><svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>${p.price.toFixed(2)} €</span>`:''}
    </div>
    <div class="product-actions">
      <button class="btn btn-danger btn-sm" onclick="openModal('${p.id}','out')">− Retirer</button>
      <button class="btn btn-primary btn-sm" onclick="openModal('${p.id}','in')">+ Ajouter</button>
    </div>`;
}

/* ============================================================
   MODAL retirer/ajouter
   ============================================================ */
function openModal(pid, type){
  const p = state.products.find(p=>p.id===pid);
  if(!p) return;
  state.modalCtx = {pid, type};
  document.getElementById('modalTitle').textContent = type==='out'?'Retirer du stock':'Ajouter au stock';
  document.getElementById('modalSub').textContent = type==='out'?'Indiquez la quantité retirée.':'Indiquez la quantité ajoutée.';
  document.getElementById('modalProduct').innerHTML = `
    <b>${escapeHtml(p.name)}</b><br>
    <span style="color:var(--text-2);font-family:'JetBrains Mono',monospace;font-size:12px">${escapeHtml(p.ref)}</span><br>
    Stock actuel : <b>${p.qty}</b>`;
  document.getElementById('modalQtyInput').value = 1;
  const btn = document.getElementById('modalConfirm');
  btn.className = 'btn ' + (type==='out'?'btn-danger':'btn-primary');
  btn.textContent = type==='out'?'Retirer':'Ajouter';
  document.getElementById('modal').classList.add('active');
}
function closeModal(){
  document.getElementById('modal').classList.remove('active');
  state.modalCtx=null;
}
function modalQty(delta){
  const inp = document.getElementById('modalQtyInput');
  const v = Math.max(1, (parseInt(inp.value)||1) + delta);
  inp.value = v;
}
function confirmModal(){
  const ctx = state.modalCtx; if(!ctx) return;
  const qty = parseInt(document.getElementById('modalQtyInput').value)||0;
  if(qty<1){toast('Quantité invalide','error');return}
  const p = state.products.find(p=>p.id===ctx.pid);
  if(!p) return;
  if(ctx.type==='out' && qty > p.qty){toast('Stock insuffisant','error');return}
  p.qty += (ctx.type==='out'?-qty:qty);
  state.history.unshift({
    id:uid(), productId:p.id, productName:p.name,
    type:ctx.type, qty, date:Date.now(), user:state.user.name
  });
  save();
  closeModal();
  toast(ctx.type==='out'?`-${qty} ${p.name}`:`+${qty} ${p.name}`);
  if(p.qty < p.threshold) toast('⚠ Stock faible : '+p.name,'error');
  // refresh visible screen
  if(state.currentCat) renderCategory(state.currentCat);
  renderHome();
}

