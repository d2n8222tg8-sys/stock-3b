<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0d1117">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>3B Stock — Atelier</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{
  --bg:#0d1117;
  --bg-2:#161b22;
  --bg-3:#1c232c;
  --line:#262d36;
  --line-2:#363f4c;
  --text:#e6edf3;
  --text-2:#8b949e;
  --text-3:#6e7681;
  --green:#3FA535;        /* vert 3B */
  --green-dark:#2e7d27;
  --green-glow:rgba(63,165,53,.25);
  --yellow:#F5C518;       /* jaune BTP */
  --orange:#ff8800;
  --red:#e54848;
  --red-bg:rgba(229,72,72,.12);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;overscroll-behavior:none}
body{padding-bottom:env(safe-area-inset-bottom)}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,select,textarea{font-family:inherit;font-size:16px;background:var(--bg-3);border:1px solid var(--line);color:var(--text);padding:14px 16px;border-radius:10px;width:100%;outline:none;transition:border .15s}
input:focus,select:focus,textarea:focus{border-color:var(--green)}
label{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2);margin-bottom:6px;font-weight:600}

/* ===== Light mode ===== */
body.light{
–bg:#f4f5f7;–bg-2:#fff;–bg-3:#fafbfc;
–line:#e1e4e8;–line-2:#d0d7de;
–text:#1f2328;–text-2:#5e6772;–text-3:#8c959f;
}
body.light input,body.light select,body.light textarea{background:#fff}

/* ===== Layout ===== */
.app{max-width:520px;margin:0 auto;min-height:100vh;background:var(–bg);padding-bottom:90px}
.screen{display:none;animation:fadeIn .25s ease}
.screen.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ===== Header ===== */
.header{
position:sticky;top:0;z-index:50;
background:linear-gradient(180deg,var(–bg) 70%,rgba(13,17,23,0));
padding:18px 20px 14px;
display:flex;align-items:center;gap:14px;
}
body.light .header{background:linear-gradient(180deg,var(–bg) 70%,rgba(244,245,247,0))}
.header h1{
font-family:‘Barlow Condensed’,sans-serif;
font-size:26px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;
flex:1
}
.header .accent{color:var(–green)}
.icon-btn{
width:42px;height:42px;border-radius:10px;background:var(–bg-2);
display:flex;align-items:center;justify-content:center;
transition:transform .12s;
}
.icon-btn:active{transform:scale(.94)}
.icon-btn svg{width:20px;height:20px;stroke:var(–text);fill:none;stroke-width:2}
.role-pill{
font-size:10px;letter-spacing:.1em;text-transform:uppercase;
padding:6px 10px;border-radius:20px;font-weight:700;
background:var(–green);color:#000
}
.role-pill.boss{background:var(–yellow)}

/* ===== Login ===== */
.login-screen{
display:flex;flex-direction:column;justify-content:center;
min-height:100vh;padding:30px;
}
.login-screen.active{display:flex}
.login-logo{
text-align:center;margin-bottom:40px;
}
.login-logo .badge{
display:inline-block;
font-family:‘Barlow Condensed’,sans-serif;
font-size:64px;font-weight:800;line-height:1;
color:var(–green);letter-spacing:.02em;
text-shadow:0 0 30px var(–green-glow);
}
.login-logo .sub{
font-family:‘JetBrains Mono’,monospace;
font-size:11px;color:var(–text-2);
letter-spacing:.3em;text-transform:uppercase;margin-top:8px;
}
.login-card{
background:var(–bg-2);border:1px solid var(–line);
border-radius:18px;padding:28px;
}
.login-card h2{
font-family:‘Barlow Condensed’,sans-serif;
font-size:22px;text-transform:uppercase;letter-spacing:.05em;
margin-bottom:20px;
}
.role-tabs{display:flex;gap:10px;margin-bottom:24px}
.role-tab{
flex:1;padding:14px;border-radius:10px;
background:var(–bg-3);border:1px solid var(–line);
text-align:center;font-weight:600;font-size:13px;
text-transform:uppercase;letter-spacing:.06em;
transition:all .15s;
}
.role-tab.active{
background:var(–green);color:#000;border-color:var(–green);
}
.role-tab.boss.active{background:var(–yellow);color:#000;border-color:var(–yellow)}

/* ===== Buttons ===== */
.btn{
display:flex;align-items:center;justify-content:center;gap:8px;
padding:16px 20px;border-radius:12px;font-weight:600;
font-size:15px;text-transform:uppercase;letter-spacing:.04em;
transition:transform .1s,opacity .15s;width:100%;
}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(–green);color:#000}
.btn-yellow{background:var(–yellow);color:#000}
.btn-danger{background:var(–red);color:#fff}
.btn-ghost{background:var(–bg-3);border:1px solid var(–line);color:var(–text)}
.btn-sm{padding:10px 14px;font-size:13px}

/* ===== Home : categories ===== */
.welcome{padding:0 20px 20px}
.welcome .hello{font-size:13px;color:var(–text-2);text-transform:uppercase;letter-spacing:.1em;font-weight:600}
.welcome .name{font-family:‘Barlow Condensed’,sans-serif;font-size:30px;font-weight:700;margin-top:4px}

.search-bar{
margin:0 20px 18px;position:relative;
}
.search-bar input{padding-left:46px}
.search-bar svg{
position:absolute;left:14px;top:50%;transform:translateY(-50%);
width:18px;height:18px;stroke:var(–text-2);fill:none;stroke-width:2
}

.quick-stats{
display:grid;grid-template-columns:repeat(3,1fr);gap:10px;
padding:0 20px 20px;
}
.stat-mini{
background:var(–bg-2);border:1px solid var(–line);
border-radius:12px;padding:14px 12px;text-align:center;
}
.stat-mini .v{font-family:‘Barlow Condensed’,sans-serif;font-size:28px;font-weight:700;line-height:1}
.stat-mini .l{font-size:10px;color:var(–text-2);text-transform:uppercase;letter-spacing:.08em;margin-top:6px;font-weight:600}
.stat-mini.alert .v{color:var(–red)}

.section-title{
font-family:‘Barlow Condensed’,sans-serif;
font-size:18px;font-weight:700;text-transform:uppercase;
letter-spacing:.08em;padding:8px 20px 14px;
display:flex;align-items:center;gap:8px;
}
.section-title::after{
content:””;flex:1;height:1px;background:var(–line);
}

.cat-grid{
display:grid;grid-template-columns:1fr 1fr;gap:12px;
padding:0 20px;
}
.cat{
position:relative;
background:var(–bg-2);
border:1px solid var(–line);
border-radius:16px;
padding:20px 16px 18px;
text-align:left;
overflow:hidden;
transition:transform .12s,border-color .15s;
min-height:120px;
}
.cat:active{transform:scale(.97)}
.cat::before{
content:””;position:absolute;top:0;left:0;right:0;height:3px;
background:var(–cat-color,var(–green));
}
.cat .icon{
width:38px;height:38px;
display:flex;align-items:center;justify-content:center;
background:color-mix(in srgb,var(–cat-color,var(–green)) 15%,transparent);
border-radius:10px;margin-bottom:10px;
}
.cat .icon svg{width:22px;height:22px;stroke:var(–cat-color,var(–green));fill:none;stroke-width:2}
.cat .name{
font-family:‘Barlow Condensed’,sans-serif;
font-size:19px;font-weight:700;text-transform:uppercase;letter-spacing:.02em;
line-height:1.1;
}
.cat .count{
font-family:‘JetBrains Mono’,monospace;
font-size:11px;color:var(–text-2);margin-top:6px;
}
.cat .badge-alert{
position:absolute;top:10px;right:10px;
background:var(–red);color:#fff;
font-size:10px;font-weight:700;
padding:3px 7px;border-radius:20px;
font-family:‘JetBrains Mono’,monospace;
}

/* ===== Product list ===== */
.product-list{padding:0 20px;display:flex;flex-direction:column;gap:10px}
.product{
background:var(–bg-2);border:1px solid var(–line);
border-radius:14px;padding:16px;
transition:border-color .15s;
}
.product.low{border-color:var(–red);background:linear-gradient(135deg,var(–red-bg),transparent)}
.product-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.product .name{font-weight:600;font-size:15px;line-height:1.3}
.product .ref{font-family:‘JetBrains Mono’,monospace;font-size:11px;color:var(–text-2);margin-top:3px}
.product .qty{
font-family:‘Barlow Condensed’,sans-serif;
font-size:32px;font-weight:700;line-height:1;
color:var(–green);
}
.product.low .qty{color:var(–red)}
.product .qty-unit{font-size:11px;color:var(–text-2);text-transform:uppercase;letter-spacing:.08em;margin-top:2px;text-align:right}
.product-meta{
display:flex;gap:12px;margin-top:10px;font-size:12px;color:var(–text-2);
flex-wrap:wrap;
}
.product-meta span{display:flex;align-items:center;gap:4px}
.product-meta svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}
.product-actions{display:flex;gap:8px;margin-top:14px}
.product-actions .btn{flex:1;padding:12px;font-size:13px}
.low-tag{
display:inline-block;font-size:10px;font-weight:700;
background:var(–red);color:#fff;padding:3px 8px;border-radius:20px;
text-transform:uppercase;letter-spacing:.08em;margin-top:6px;
}

.empty{
text-align:center;padding:60px 20px;color:var(–text-2);
}
.empty svg{width:48px;height:48px;stroke:var(–text-3);fill:none;stroke-width:1.5;margin-bottom:16px}
.empty p{font-size:14px}

/* ===== Form ===== */
.form-stack{padding:0 20px;display:flex;flex-direction:column;gap:16px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-actions{padding:20px;display:flex;gap:10px}

/* ===== Modal ===== */
.modal-bg{
position:fixed;inset:0;background:rgba(0,0,0,.7);
z-index:200;display:none;align-items:flex-end;
backdrop-filter:blur(4px);
}
.modal-bg.active{display:flex;animation:fadeIn .2s}
.modal{
background:var(–bg-2);width:100%;max-width:520px;margin:0 auto;
border-radius:24px 24px 0 0;
padding:24px 24px calc(24px + env(safe-area-inset-bottom));
animation:slideUp .3s cubic-bezier(.2,.8,.2,1);
}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:none}}
.modal h3{
font-family:‘Barlow Condensed’,sans-serif;
font-size:22px;text-transform:uppercase;letter-spacing:.04em;
margin-bottom:6px;
}
.modal .sub{color:var(–text-2);font-size:13px;margin-bottom:20px}
.modal .product-info{
background:var(–bg-3);border:1px solid var(–line);
padding:14px;border-radius:10px;margin-bottom:18px;
font-size:13px;
}
.modal .product-info b{font-size:14px}
.qty-controls{display:flex;align-items:center;gap:14px;margin:18px 0}
.qty-controls button{
width:54px;height:54px;border-radius:14px;
background:var(–bg-3);border:1px solid var(–line);
font-size:28px;font-weight:700;
}
.qty-controls input{
flex:1;text-align:center;font-family:‘Barlow Condensed’,sans-serif;
font-size:32px;font-weight:700;padding:10px;
}
.modal-actions{display:flex;gap:10px}

/* ===== Dashboard ===== */
.dash{padding:0 20px}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
.kpi{
background:var(–bg-2);border:1px solid var(–line);
border-radius:14px;padding:18px;
position:relative;overflow:hidden;
}
.kpi::before{content:””;position:absolute;top:0;left:0;width:3px;height:100%;background:var(–green)}
.kpi.yellow::before{background:var(–yellow)}
.kpi.red::before{background:var(–red)}
.kpi .label{font-size:11px;color:var(–text-2);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.kpi .value{font-family:‘Barlow Condensed’,sans-serif;font-size:32px;font-weight:700;margin-top:4px;line-height:1}
.kpi .value .unit{font-size:14px;color:var(–text-2);font-weight:500}

.chart-card{
background:var(–bg-2);border:1px solid var(–line);
border-radius:14px;padding:18px;margin-bottom:14px;
}
.chart-card h3{
font-family:‘Barlow Condensed’,sans-serif;
font-size:16px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px;
}
.chart-card canvas{max-height:200px}

.history-list{display:flex;flex-direction:column;gap:8px}
.history-item{
display:flex;align-items:center;gap:12px;
padding:12px;background:var(–bg-3);border-radius:10px;
font-size:13px;
}
.history-item .ico{
width:32px;height:32px;border-radius:8px;
display:flex;align-items:center;justify-content:center;
flex-shrink:0;
}
.history-item.out .ico{background:var(–red-bg);color:var(–red)}
.history-item.in .ico{background:rgba(63,165,53,.15);color:var(–green)}
.history-item .ico svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5}
.history-item .info{flex:1;min-width:0}
.history-item .info .n{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.history-item .info .d{font-size:11px;color:var(–text-2);margin-top:2px}
.history-item .q{font-family:‘Barlow Condensed’,sans-serif;font-size:20px;font-weight:700}
.history-item.out .q{color:var(–red)}
.history-item.in .q{color:var(–green)}

/* ===== Bottom nav ===== */
.tabbar{
position:fixed;bottom:0;left:0;right:0;
background:var(–bg-2);border-top:1px solid var(–line);
padding:8px 0 calc(8px + env(safe-area-inset-bottom));
display:flex;justify-content:space-around;
z-index:100;
max-width:520px;margin:0 auto;
}
.tab{
flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
padding:8px 4px;color:var(–text-3);
transition:color .15s;
}
.tab svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2}
.tab span{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.tab.active{color:var(–green)}
body.light .tabbar{background:#fff}

/* ===== Notif toast ===== */
.toast{
position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-100px);
background:var(–green);color:#000;padding:14px 22px;border-radius:30px;
font-weight:600;font-size:14px;z-index:300;
box-shadow:0 8px 30px rgba(0,0,0,.4);
transition:transform .3s cubic-bezier(.2,.8,.2,1);
}
.toast.error{background:var(–red);color:#fff}
.toast.show{transform:translateX(-50%) translateY(0)}

/* ===== Misc ===== */
.divider{height:1px;background:var(–line);margin:20px}
.back-btn{
display:flex;align-items:center;gap:6px;
padding:8px 14px;background:var(–bg-3);border-radius:20px;
font-size:13px;color:var(–text-2);font-weight:500;
}
.back-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.5}

.filter-chips{
display:flex;gap:8px;padding:0 20px 14px;overflow-x:auto;
-webkit-overflow-scrolling:touch;
}
.filter-chips::-webkit-scrollbar{display:none}
.chip{
flex-shrink:0;padding:8px 14px;border-radius:20px;
background:var(–bg-3);border:1px solid var(–line);
font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;
white-space:nowrap;
}
.chip.active{background:var(–green);color:#000;border-color:var(–green)}
</style>

</head>
