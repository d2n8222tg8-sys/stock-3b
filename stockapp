function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+id).classList.add('active');
  // Remonter en haut immédiatement (compatible iOS + Android)
  window.scrollTo({top:0, left:0, behavior:'instant'});
  document.documentElement.scrollTop = 0;
  document.body.scrollTop = 0;
}
function goTab(tab){
  if(tab==='logout'){logout();return}
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelector(`.tab[data-tab="${tab}"]`)?.classList.add('active');
  if(tab==='home') renderHome();
  else if(tab==='reorder') renderReorder();
  else if(tab==='dash') renderDash();
  else if(tab==='history') renderHistory();
  showScreen(tab);
}
function goHome(){goTab('home')}

/* ============================================================
   HOME
   ============================================================ */
function renderHome(){
  const grid = document.getElementById('catGrid');
  grid.innerHTML='';
  CATS.forEach(c=>{
    const prods = state.products.filter(p=>p.cat===c.id);
    const low = prods.filter(p=>p.qty < p.threshold).length;
    const el = document.createElement('button');
    el.className='cat';
    el.style.setProperty('--cat-color', c.color);
    el.innerHTML = `
      ${low>0?`<div class="badge-alert">${low}</div>`:''}
      <div class="icon">${c.icon}</div>
      <div class="name">${c.name}</div>
      <div class="count">${prods.length} référence${prods.length>1?'s':''}</div>
    `;
    el.onclick = ()=>openCategory(c.id);
    grid.appendChild(el);
  });
  // Stats rapides
  document.getElementById('qsTotal').textContent = state.products.length;
  document.getElementById('qsLow').textContent = state.products.filter(p=>p.qty<p.threshold).length;
  const today = new Date(); today.setHours(0,0,0,0);
  document.getElementById('qsToday').textContent = state.history.filter(h=>h.date >= today.getTime()).length;
}

function globalSearch(){
  const q = document.getElementById('globalSearch').value.trim().toLowerCase();
  if(!q){renderHome();return}
  // On affiche les résultats dans la grille
  const grid = document.getElementById('catGrid');
  const results = state.products.filter(p=>
    p.name.toLowerCase().includes(q) || p.ref.toLowerCase().includes(q)
  );
  grid.innerHTML='';
  grid.style.gridTemplateColumns='1fr';
  if(results.length===0){
    grid.innerHTML = `<div class="empty"><p>Aucun produit ne correspond.</p></div>`;
    return;
  }
  results.forEach(p=>{
    const c = CATS.find(c=>c.id===p.cat);
    const low = p.qty < p.threshold;
    const el = document.createElement('div');
    el.className='product'+(low?' low':'');
    el.innerHTML = renderProductHTML(p, c);
    grid.appendChild(el);
  });
  // restore grid template
  setTimeout(()=>grid.style.gridTemplateColumns='',1);
}

